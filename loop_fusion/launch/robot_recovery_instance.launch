<launch>
    <arg name="robot" />
    <arg name="config_path" />
    <arg name="initial_x" />
    <arg name="initial_y" />
    <arg name="initial_z" default="0.0" />
    <arg name="initial_yaw_deg" />
    <arg name="use_distance_recovery" default="true" />
    <arg name="distance_recovery_rate_hz" default="3.0" />
    <arg name="visual_recovery_candidate_interval" default="0.10" />
    <arg name="relative_recovery_log_dir"
         default="/home/junwan/microswarm_ws/logs/relative_recovery/latest" />
    <!-- Recorded-bag failure emulation. The real VIO process remains healthy;
         after /<robot>/recovery_restart, poseimu/loop_pose/loop_feats are all
         expressed in a fresh local frame before reaching recovery. -->
    <arg name="simulate_local_frame_reset" default="false" />
    <arg name="frame_reset_rotation_mode" default="yaw_only" />
    <arg name="frame_reset_log_dir"
         default="/home/junwan/microswarm_ws/logs/frame_reset/latest" />

    <node if="$(arg simulate_local_frame_reset)"
          name="local_frame_reset_$(arg robot)" pkg="loop_fusion"
          type="local_frame_reset_node" output="screen" required="true">
        <param name="robot_name" value="$(arg robot)" />
        <param name="rotation_mode" value="$(arg frame_reset_rotation_mode)" />
        <param name="output_frame_id" value="$(arg robot)_vio_local" />
        <param name="audit_path"
               value="$(arg frame_reset_log_dir)/$(arg robot)_frame_reset.csv" />
        <remap from="poseimu_in" to="/ov_msckf_$(arg robot)/poseimu" />
        <remap from="loop_pose_in" to="/ov_msckf_$(arg robot)/loop_pose" />
        <remap from="loop_feats_in" to="/ov_msckf_$(arg robot)/loop_feats" />
        <remap from="restart_in" to="/$(arg robot)/recovery_restart" />
        <remap from="poseimu_out" to="/rebased_vio_$(arg robot)/poseimu" />
        <remap from="loop_pose_out" to="/rebased_vio_$(arg robot)/loop_pose" />
        <remap from="loop_feats_out" to="/rebased_vio_$(arg robot)/loop_feats" />
        <remap from="restart_out" to="/$(arg robot)/rebased_restart" />
    </node>

    <node name="loop_fusion_$(arg robot)" pkg="loop_fusion"
          type="loop_fusion_node" output="screen"
          args="$(arg config_path)" required="true">
        <rosparam subst_value="true" param="initial_world_position">
          [$(arg initial_x), $(arg initial_y), $(arg initial_z)]
        </rosparam>
        <param name="initial_world_yaw_deg" value="$(arg initial_yaw_deg)" />
        <param name="use_distance_recovery" value="$(arg use_distance_recovery)" />
        <param name="distance_recovery_rate_hz" value="$(arg distance_recovery_rate_hz)" />
        <param name="relative_recovery_log_dir" value="$(arg relative_recovery_log_dir)" />

        <remap from="/cam0/image_raw" to="/$(arg robot)/camera/infra1/image_rect_raw" />
        <remap from="/vins_estimator/extrinsic" to="/ov_msckf_$(arg robot)/loop_extrinsic" />
        <remap from="/vins_estimator/keyframe_point"
               to="$(eval ('/rebased_vio_' if arg('simulate_local_frame_reset') else '/ov_msckf_') + arg('robot') + '/loop_feats')" />
        <remap from="/vins_estimator/keyframe_pose"
               to="$(eval ('/rebased_vio_' if arg('simulate_local_frame_reset') else '/ov_msckf_') + arg('robot') + '/loop_pose')" />
        <remap from="/vins_estimator/intrinsics" to="/ov_msckf_$(arg robot)/loop_intrinsics" />
        <remap from="/vins_estimator/pose"
               to="$(eval ('/rebased_vio_' if arg('simulate_local_frame_reset') else '/ov_msckf_') + arg('robot') + '/poseimu')" />
        <remap from="/failure_recovery/recovered_pose"
               to="/$(arg robot)/failure_recovery/recovered_pose" />
        <remap from="/failure_recovery/trigger"
               to="/$(arg robot)/failure_recovery/trigger" />
        <remap from="/restart"
               to="$(eval '/' + arg('robot') + ('/rebased_restart' if arg('simulate_local_frame_reset') else '/recovery_restart'))" />
        <remap from="/ov_msckf/vio_reset" to="/ov_msckf_$(arg robot)/vio_reset" />

        <remap from="/loop_fusion_$(arg robot)/match_image"
               to="/ov_secondary_$(arg robot)/match_image" />
        <remap from="/loop_fusion_$(arg robot)/pose_rect"
               to="/ov_secondary_$(arg robot)/poseimu" />
        <remap from="/loop_fusion_$(arg robot)/odometry_rect"
               to="/ov_secondary_$(arg robot)/odomimu" />
    </node>

    <node name="failure_recovery_$(arg robot)" pkg="failure_recovery"
          type="failure_recovery_node" output="screen"
          args="$(arg config_path)" required="true">
        <rosparam subst_value="true" param="initial_world_position">
          [$(arg initial_x), $(arg initial_y), $(arg initial_z)]
        </rosparam>
        <param name="initial_world_yaw_deg" value="$(arg initial_yaw_deg)" />
        <param name="recovery_candidate_interval" value="$(arg visual_recovery_candidate_interval)" />

        <remap from="/cam0/image_raw" to="/$(arg robot)/camera/infra1/image_rect_raw" />
        <remap from="/vins_estimator/keyframe_point"
               to="$(eval ('/rebased_vio_' if arg('simulate_local_frame_reset') else '/ov_msckf_') + arg('robot') + '/loop_feats')" />
        <remap from="/vins_estimator/keyframe_pose"
               to="$(eval ('/rebased_vio_' if arg('simulate_local_frame_reset') else '/ov_msckf_') + arg('robot') + '/loop_pose')" />
        <remap from="/vins_estimator/intrinsics" to="/ov_msckf_$(arg robot)/loop_intrinsics" />
        <remap from="/vins_estimator/extrinsic" to="/ov_msckf_$(arg robot)/loop_extrinsic" />
        <remap from="/failure_recovery/trigger"
               to="/$(arg robot)/failure_recovery/trigger" />
        <remap from="/failure_recovery/recovered_pose"
               to="/$(arg robot)/failure_recovery/recovered_pose" />
        <remap from="/restart"
               to="$(eval '/' + arg('robot') + ('/rebased_restart' if arg('simulate_local_frame_reset') else '/recovery_restart'))" />
        <remap from="/ov_msckf/vio_reset" to="/ov_msckf_$(arg robot)/vio_reset" />
    </node>
</launch>
